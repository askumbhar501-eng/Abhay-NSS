# AquaSentinel AI Environment Configuration
# Copy this file to .env and adjust variables as needed

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=True

# IBM watsonx.ai & Cloudant Configuration
IBM_WATSONX_APIKEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_CLOUDANT_URL=
IBM_CLOUDANT_APIKEY=
IBM_EVENT_STREAMS_BOOTSTRAP_SERVERS=

# Simulation & Telemetry
SIMULATION_INTERVAL_SEC=3
NOISE_LEVEL=0.015
